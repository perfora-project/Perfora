#!/bin/sh
# Refuse to push directly to main.
#
# GitHub cannot enforce this server-side today (branch protection and rulesets
# need GitHub Pro/Team for a private repository), so this hook stands in for it
# locally. Install it with:
#
#     ./scripts/install-git-hooks.sh
#
# Work on a branch and open a pull request instead:
#
#     git switch -c feat/my-change
#     git push -u origin feat/my-change
#     gh pr create --fill
#
# To override for one push — a genuine emergency, or the very first push of a
# fresh clone:
#
#     PERFORA_ALLOW_PUSH_MAIN=1 git push origin main

set -eu

protected_ref="refs/heads/main"
zero="0000000000000000000000000000000000000000"

while read -r _local_ref local_sha remote_ref _remote_sha; do
    [ "$remote_ref" = "$protected_ref" ] || continue

    # A deletion push ($local_sha all zeroes) is even less what we want.
    if [ "$local_sha" = "$zero" ]; then
        printf '%s\n' "pre-push: refusing to delete $protected_ref." >&2
        exit 1
    fi

    if [ -n "${PERFORA_ALLOW_PUSH_MAIN:-}" ]; then
        printf '%s\n' "pre-push: PERFORA_ALLOW_PUSH_MAIN is set — allowing push to main." >&2
        continue
    fi

    cat >&2 <<'MSG'
pre-push: direct pushes to main are not allowed in this repository.

Put the work on a branch and open a pull request, so CI runs before it
lands on main:

    git switch -c feat/my-change      # move the commits to a branch
    git push -u origin feat/my-change
    gh pr create --fill

If the commits are already on your local main, move them across with:

    git switch -c feat/my-change
    git switch main && git reset --hard origin/main

Override for a single push (emergencies only):

    PERFORA_ALLOW_PUSH_MAIN=1 git push origin main
MSG
    exit 1
done

exit 0
